// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
//
// OpenWRT device tree for the Bodybytes board (MT7628AN).

#include "mt7628an.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "bodybytes,bodybytes", "mediatek,mt7628an-soc";
	model = "Bodybytes";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x04000000>;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};
};

/* SPI NOR W25Q512JV, 64 MB: bootloader + WiFi EEPROM only; OS on eMMC. */
&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x40000 0x10000>;
				read-only;
			};

			factory: partition@50000 {
				label = "factory";
				reg = <0x50000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x400>;
					};
				};
			};

			partition@60000 {
				label = "recovery";
				reg = <0x60000 0x3fa0000>;
				read-only;
			};
		};
	};
};

&state_default {
	/*
	 * MDI P1 pads → GPIO#14-17 at pinctrl init, before sdhci probes.
	 * GPIO#14: boot-mode hall sensor; GPIO#15: eMMC RST_n.
	 */
	spis_gpio {
		groups = "spis";
		function = "gpio";
	};
};

&pinctrl {
	/*
	 * AGPIO_CFG EPHY_GPIO_AIO_EN[4:1] = 0xf: all four EPHY groups digital.
	 * P4 analog severs the MSDC digital path from CLK/CMD — no comms possible.
	 * EPHY P4 input buffer loads CMD/CLK in idle, but push-pull command/response
	 * phases (MSDC ~50Ω, card ~50Ω) easily overcome the ~500Ω EPHY load.
	 */
	ephy-digital;

	/*
	 * IoT SDXC routing: ESD mux → iot routes SDXC to MDI/EPHY pads.
	 * This is the hardware reset default; setting it explicitly here for clarity.
	 * EPHY digital mode is applied board-wide via ephy-digital above.
	 */
	sdxc_iot_mode: sdxc_iot_mode {
		esd {
			groups = "esd";
			function = "iot";
		};

		sdxc {
			groups = "sdmode";
			function = "sdxc";
		};
	};
};

/ {
	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
	};

	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * TI DRV5032FCDBZT hall sensor, GPIO#14 (MDI_TP_P1), active-low.
	 * Low = magnet = recovery boot. Exposes state to userspace via /dev/input.
	 */
	keys {
		compatible = "gpio-keys";

		boot-mode {
			label = "boot-mode";
			linux,code = <BTN_0>;
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};
	};
};

/* SD/eMMC on SDXC/IoT pads. EPHY groups digital via &pinctrl ephy-digital. */
&sdhci {
	status = "okay";

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&sdxc_iot_mode>;
	pinctrl-1 = <&sdxc_iot_mode>;

	/*
	 * SD/MMC High-Speed, 48 MHz (max at 3.3 V; HS200/400 need 1.8 V).
	 * cap-sd-highspeed / cap-mmc-highspeed are inherited from mt7628an.dtsi.
	 * Requires strap in GPIO/EPHY_LED mode (JTAG off) — JTAG breaks SD-on-EPHY.
	 */
	max-frequency = <48000000>;

	no-sdio;
	non-removable;
	vmmc-supply = <&reg_3v3>;
	vqmmc-supply = <&reg_3v3>;
	mmc-pwrseq = <&emmc_pwrseq>;
};

&uartlite {
	status = "disabled";
};

&usbphy {
	status = "disabled";
};

&ehci {
	status = "disabled";
};

&ohci {
	status = "disabled";
};

&uart2 {
	status = "okay";
};

/*
 * No ethernet ports are wired, but the switch/PHY block is left enabled (its
 * hardware-reset default) on purpose: probing it brings the EPHY out of its
 * abnormal idle state, which the SD/eMMC pads (shared with EPHY P1-P4 in IoT
 * mode) depend on to idle high. Disabling it leaves SD DAT0 stuck low.
 * &ethernet and &esw are enabled by mt7628an.dtsi; do not override to disabled.
 */

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";

	/*
	 * Merge eFuse RF calibration (TX power, RSSI offsets, crystal trim)
	 * into the external EEPROM; without this, a custom EEPROM would use
	 * uncalibrated RF defaults.
	 */
	mediatek,eeprom-merge-otp;

	led {
		status = "disabled";
	};
};
