// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
//
// OpenWRT device tree for the Bodybytes board (MT7628AN).

#include "mt7628an.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "bodybytes,bodybytes", "mediatek,mt7628an-soc";
	model = "Bodybytes";

	memory@0 { 
		device_type = "memory"; 
		reg = <0x00000000 0x04000000>;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};
};

/*
 * SPI NOR: W25Q512JV, 64 MB, CS0, 25 MHz.
 * NOR holds only the bootloader and WiFi EEPROM; the OS lives on eMMC.
 */
&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x40000 0x10000>;
				read-only;
			};

			factory: partition@50000 {
				label = "factory";
				reg = <0x50000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x400>;
					};
				};
			};

			partition@60000 {
				label = "recovery";
				reg = <0x60000 0x3fa0000>;
				read-only;
			};
		};
	};
};

&pinctrl {
	/*
	 * ephy-digital: sets AGPIO_CFG EPHY_GPIO_AIO_EN[4:1]=0xf so all
	 * MDI P1-P4 pads operate as digital signals.  Required for:
	 *   - SDXC on MDI P3/P4 (sdxc_iot_mode)
	 *   - UART2 on MDI_P2 pads (UART2_MODE=0 from uart2_pins in dtsi)
	 */
	ephy-digital;

	/*
	 * sdxc_iot_mode: AGPIO_CFG ESD bit -> iot (routes SDXC to EPHY pads),
	 * GPIO_MODE SDMODE -> sdxc.
	 */
	sdxc_iot_mode: sdxc_iot_mode {
		esd {
			groups = "esd";
			function = "iot";
		};

		sdxc {
			groups = "sdmode";
			function = "sdxc";
		};
	};

	/*
	 * mdi_p1_gpio: SPIS_MODE=gpio -> MDI P1 pads become GPIO#14-17.
	 * Required so GPIO#14 (MDI_TP_P1) is readable as the boot-mode key.
	 */
	mdi_p1_gpio: mdi_p1_gpio {
		spis_gpio {
			groups = "spis";
			function = "gpio";
		};
	};
};

/ {
	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * Boot mode selector: TI DRV5032FCDBZT hall-effect sensor on MDI_TP_P1
	 * (SoC pin 43, GPIO#14, active-low).  Low = magnet present = recovery
	 * boot (already selected by U-Boot before Linux starts).  Exposed here
	 * so userspace can read current physical state via /dev/input/eventN.
	 */
	keys {
		compatible = "gpio-keys";

		boot-mode {
			label = "boot-mode";
			linux,code = <BTN_0>;
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * SD card: removable, connected on EPHY MDI P3/P4 pads via sdxc_iot_mode.
 * mediatek,cd-poll enables kernel polling for card insertion/removal.
 */
&sdhci {
	status = "okay";

	vmmc-supply = <&reg_3v3>;
	vqmmc-supply = <&reg_3v3>;
	no-1-8-v;

	pinctrl-0 = <&sdxc_iot_mode &mdi_p1_gpio>;

	mediatek,cd-poll;
};

&uartlite {
	status = "disabled";
};

&uart2 {
	status = "okay";
};

&ethernet {
	status = "disabled";
};

&esw {
	status = "disabled";
};

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";

	/*
	 * Merge on-chip eFuse RF calibration into the external EEPROM.
	 * The eFuse (burned by MediaTek at wafer test) provides per-chip
	 * TX power, RSSI offsets, and crystal trim. Without this, a custom
	 * EEPROM with only a MAC address set would have zeroed RF fields
	 * and the radio would use uncalibrated defaults.
	 * If the external EEPROM is erased/invalid, the driver ignores this
	 * property and copies the eFuse wholesale instead.
	 */
	mediatek,eeprom-merge-otp;
};
