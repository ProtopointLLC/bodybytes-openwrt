#!/bin/sh /etc/rc.common
# Pre-creates dufs's public/protected dirs once, marker-guarded.
# Runs after fstab (11) mounts /mnt/data, before dufs (99); can't be done from uci-defaults (10).

START=12

MARKER=/mnt/data/.dufs_provisioned

boot() {
	case $(board_name) in
	bodybytes,bodybytes)
		if [ -f /etc/config/dufs ] && [ ! -f "$MARKER" ]; then
			mkdir -p /mnt/data/public /mnt/data/protected
			touch "$MARKER"
		fi
		;;
	esac
}
