#!/bin/sh /etc/rc.common
# Boot fallback for ttyd: it can start before br-lan has its addresses and
# then exit with no respawn configured. Wait for both, then restart it once.

START=99

boot() {
	case $(board_name) in
	bodybytes,bodybytes)
		(
			i=0
			while [ "$i" -lt 30 ]; do
				ip -4 addr show dev br-lan 2>/dev/null | grep -q 'scope global' && \
				ip -6 addr show dev br-lan 2>/dev/null | grep -q 'scope global' && break
				sleep 1
				i=$((i + 1))
			done
			/etc/init.d/ttyd restart
		) &
		;;
	esac
}
